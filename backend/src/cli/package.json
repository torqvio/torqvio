{
  "name": "torqvio-cli",
  "version": "2.1.0",
  "description": "Torqvio CLI - Instant workflow deployment and management",
  "main": "dist/index.js",
  "bin": {
    "torqvio": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "workflow",
    "automation",
    "deployment",
    "torqvio",
    "nodejs",
    "typescript",
    "devops",
    "cicd"
  ],
  "author": "Torqvio Team <team@torqvio.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/torqvio/cli.git"
  },
  "bugs": {
    "url": "https://github.com/torqvio/cli/issues"
  },
  "homepage": "https://github.com/torqvio/cli#readme",
  "dependencies": {
    "axios": "^1.13.6",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "inquirer": "^13.3.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/uuid": "^11.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
