# ============================================================
# Torqvio — Production Environment Variables
# Copy to /var/www/aetherflow/.env and fill in real values.
# NEVER commit this file with real secrets.
# ============================================================

# --- Database ---
POSTGRES_DB=torqvio
POSTGRES_USER=torqvio
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# --- App URLs ---
API_BASE_URL=https://YOUR_DOMAIN.com/api
CORS_ORIGIN=https://YOUR_DOMAIN.com

# --- Secrets (min 32 chars each) ---
JWT_SECRET=CHANGE_ME_min_32_chars_jwt_secret_here
NEXTAUTH_SECRET=CHANGE_ME_min_32_chars_nextauth_secret_here
API_KEY_SECRET=CHANGE_ME_min_32_chars_api_key_secret_here

# --- OAuth (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Logging ---
LOG_LEVEL=warn
