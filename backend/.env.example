# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/torqvio
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=torqvio
DATABASE_USER=your_db_username
DATABASE_PASSWORD=your_db_password

# Server Configuration
PORT=8459
NODE_ENV=development

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
NEXTAUTH_SECRET=your_nextauth_secret_key_min_32_chars

# OAuth Providers (Optional)
# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth  
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# Scheduler Configuration
SCHEDULER_INTERVAL_MS=5000
MAX_RETRY_ATTEMPTS=3

# API Configuration
API_BASE_URL=http://localhost:8459
CORS_ORIGIN=http://localhost:7243
API_KEY_SECRET=your_super_secret_api_key_min_32_chars

# Email Configuration
SMTP_HOST=mail.torqvio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@torqvio.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=Torqvio <no-reply@torqvio.com>
FRONTEND_URL=http://localhost:7243
