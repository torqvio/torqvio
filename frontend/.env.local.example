# Frontend Configuration
PORT=7243

# API Configuration  
API_URL=http://localhost:8459

# Public Environment Variables (NEXT_PUBLIC_ prefix)
# These are exposed to the browser - keep them safe!
NEXT_PUBLIC_API_URL=http://localhost:8459
NEXT_PUBLIC_APP_NAME=Torqvio
NEXT_PUBLIC_APP_VERSION=1.0.0

# OAuth Configuration (Public)
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Analytics (Optional)
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true
